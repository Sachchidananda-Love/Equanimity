# Public web application configuration only. Never add admin credentials here.
VITE_FIREBASE_ENABLED=false
VITE_FIREBASE_API_KEY=REPLACE_WITH_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
VITE_FIREBASE_APP_ID=REPLACE_WITH_WEB_APP_ID
VITE_FIREBASE_USE_EMULATORS=false

# Required before TestFlight distribution: your published HTTPS privacy policy.
# Leave empty until a real URL is available; the app shows an explicit notice.
VITE_PRIVACY_POLICY_URL=
