# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# vercel
.vercel

/dist/
/dist-mobile/
/.wrangler/
/outputs/
/work/

# Keep native project/source/assets; regenerate only copied web output/cache.
/ios/App/App/public/
/ios/App/App/capacitor.config.json
/ios/App/App/config.xml
/ios/DerivedData/
/ios/build/
**/xcuserdata/
**/.swiftpm/
**/.build/
*.xcuserstate
